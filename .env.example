# Copy to .env.local. Never commit actual credentials.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: use Supabase's service_role key, never a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Remote Hustle
# Generate a random secret of at least 32 characters for the protected cron.
CRON_SECRET=
# Use a Paystack TEST secret while validating checkout; switch to live only after launch approval.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
# Final company details are needed before publication of legal pages.
LEGAL_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=

# Bot protection: same Turnstile widget configured in Supabase Auth CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Independent random secret of at least 32 characters. Used only for contact rate-limit hashes.
CONTACT_RATE_SECRET=
# Enable only on the approved public production deployment; preview stays noindex.
SITE_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
# Comma-separated local device hostnames/IPs, without http:// (development only).
DEV_ALLOWED_ORIGINS=
# Backup variables belong on your trusted backup runner, not Vercel.
# BACKUP_DATABASE_URL=
# BACKUP_ENCRYPTION_KEY=64 hexadecimal characters, stored separately from backups
# BACKUP_OUTPUT_DIR=.backups
